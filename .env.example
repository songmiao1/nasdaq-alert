# SMTP email configuration (copy this file to .env and fill in values)
SMTP_SERVER=smtp.qq.com:465
SMTP_SSL=true
SMTP_EMAIL=your_email@qq.com
SMTP_PASSWORD=your_authorization_code
SMTP_NAME=Nasdaq Alert
SMTP_TO=your_email@qq.com

# Monitor configuration
NDX_THRESHOLD_PCT=-0.8
NDX_TICKER=^NDX
NDX_CHECK_INTERVAL=60
NDX_ALERT_COOLDOWN=1800
NDX_MARKET_TZ=America/New_York
NDX_LOG_LEVEL=INFO
